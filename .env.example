# --- Database (PostgreSQL) ---
# Use Supabase Session pooler (port 5432) for Alembic migrations
# Use Supabase Transaction pooler (port 6543) for the async runtime
# Username format for Supabase: postgres.<PROJECT_REF>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/household_dev
ALEMBIC_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/household_dev

# --- Auth ---
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Storage ---
# Local dev: relative path; production: Render disk mount path
RECEIPT_STORAGE_PATH=./uploads/receipts
ASSET_STORAGE_PATH=./uploads/assets
MAX_PHOTO_WIDTH=800
PHOTO_QUALITY=85

# --- Email (Resend) ---
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Household Expenses
FRONTEND_URL=http://localhost:3000

# --- App ---
APP_ENV=development
APP_TIMEZONE=Asia/Dhaka
CORS_ORIGINS=http://localhost:3000

# --- Currency ---
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
